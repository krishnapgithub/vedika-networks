{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vedika-networks-v1",
  "main": "api/index.ts",
  "compatibility_date": "2026-06-19",

  "secrets": {
    "required": ["TMDB_ACCESS_TOKEN"]
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vedika_prod_db",
      "database_id": "27a9346c-3bab-40f6-903d-96c27b99ba85"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROFILE_PHOTOS",
      "bucket_name": "vedika-profile-images"
    }
  ]
}